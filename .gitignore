# This .gitignore file should be placed at the root of your Unity project directory.

/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Cc]aptores/
/[Mm]emoryCaptures/
/[Cc]rashlytics/
/[Cc]rashlytics-build/
/[Ll]ogs/
/[Vv]ideo/
/[Rr]ecordings/

# Generated folders by Unity's Package Manager
/[Pp]ackages/com.unity.*

# Asset database and cache folders
/[Aa]sset[Dd]ata[Bb]ase/

# Auto-generated project files by IDEs (Visual Studio, Rider, VS Code)
ExportedObj/
.vs/
.gradle/
.idea/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity serializes text settings, but these are local IDE cache files
/.vs/
/DerivedData/
/Library/
/Logs/
/obj/

# Build artifacts (OS-specific and executable outputs)
*.apk
*.aab
*.unitypackage
*.app

# Crash reports and system logs
sysinfo.txt
mono_crash.*
crashlytics-build.properties

# OS-generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V10
.Trashes
ehthumbs.db
Thumbs.db
