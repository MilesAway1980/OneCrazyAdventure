<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Editor%20Menu/editorStylesheet.uss?fileID=7433441132597879392&amp;guid=c494ac0ac50d77c4a9f9959ae4c8a153&amp;type=3#editorStylesheet" />
    <ui:VisualElement name="editor" class="editorMenu" style="flex-grow: 1; background-color: rgb(0, 0, 0); width: auto; height: auto; border-left-color: rgb(255, 0, 0); border-right-color: rgb(255, 0, 0); border-top-color: rgb(255, 0, 0); border-bottom-color: rgb(255, 0, 0); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px;">
        <ui:VisualElement name="save_load_buttons" style="flex-grow: 1; flex-direction: row; height: 30px; justify-content: center; align-self: stretch; font-size: 16px;">
            <ui:Button text="Load" name="load-button" style="width: auto;" />
            <ui:Button text="Save" name="save-button" style="visibility: visible; left: 0; word-spacing: 0; letter-spacing: 0; text-shadow: 0 0 0 rgba(0, 0, 0, 0); width: auto; overflow: hidden; opacity: 1; flex-direction: column;" />
        </ui:VisualElement>
        <ui:VisualElement name="collapse-settings" style="flex-grow: 1; flex-direction: row; height: 30px; border-top-width: 0; margin-bottom: 0; padding-bottom: 0; margin-top: 0; padding-top: 0; width: auto; align-items: stretch;">
            <ui:Toggle label="Collapse&#10;" name="collapse-toggle" toggle-on-label-click="true" value="false" tooltip="Tile collapses when player stands on it" class="toggleField" style="color: rgb(229, 229, 229); -unity-text-align: upper-left; width: auto; flex-direction: row-reverse; margin-right: 4px; flex-wrap: nowrap; height: 30px; margin-top: 2px; align-items: stretch; justify-content: flex-start; align-self: stretch;" />
            <ui:FloatField label="Time until Collapse" value="0" name="collapse-toggle-time-until-collapse" tooltip="How long a character needs to stand on the tile before it collapses." enabled="true" class="inputField" style="flex-direction: row; color: rgb(255, 0, 0); -unity-text-outline-color: rgb(0, 0, 0); background-color: rgb(0, 0, 0); opacity: 1; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); width: auto; height: 30px; font-size: 10px; align-items: stretch; align-content: auto; background-size: 100% 100%; transform-origin: center; text-overflow: clip; white-space: nowrap; -unity-text-align: upper-left; margin-left: 0; margin-right: 4px; padding-right: 0; padding-left: 0; min-width: auto; max-width: none; flex-shrink: 0; flex-basis: auto; -unity-font-style: normal; scale: 1 1; rotate: 0; border-left-width: 0; border-right-width: 0; margin-bottom: 2px; padding-top: 0; flex-wrap: nowrap; justify-content: flex-start; align-self: auto; overflow: hidden; visibility: visible; display: flex; position: relative; flex-grow: 0; border-top-width: 0;" />
            <ui:FloatField label="Time until Repair" value="-1" name="collapse-toggle-time-until-repair" tooltip="How long after the tile collapses until it restores.  -1 for never." class="inputField" style="flex-direction: row; color: rgb(255, 0, 0); -unity-text-outline-color: rgb(0, 0, 0); background-color: rgb(0, 0, 0); opacity: 1; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); width: auto; height: 30px;" />
        </ui:VisualElement>
        <ui:VisualElement name="magnetic-settings" style="flex-grow: 1; flex-direction: row; height: 30px; border-top-width: 0; margin-bottom: 0; padding-bottom: 0; margin-top: 0; padding-top: 0; width: auto;">
            <ui:Toggle label="Magnetic&#10;" name="magnetic-toggle" toggle-on-label-click="true" value="false" tooltip="Tile pulls magnetic objects toward it" class="toggleField" style="color: rgb(229, 229, 229); -unity-text-align: upper-left; width: auto; flex-direction: row-reverse; margin-right: 4px; flex-wrap: nowrap; height: 30px; margin-top: 2px;" />
            <ui:FloatField label="Strength&#10;" value="0" name="magnetic-toggle-strength" tooltip="How strong the magnetic pull is" enabled="true" class="inputField" style="flex-direction: row; color: rgb(255, 0, 0); -unity-text-outline-color: rgb(0, 0, 0); background-color: rgb(0, 0, 0); opacity: 1; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); width: auto; height: 30px; font-size: 10px; align-items: stretch; align-content: auto; background-size: 100% 100%; transform-origin: center; text-overflow: clip; white-space: nowrap; -unity-text-align: upper-left; margin-left: 0; margin-right: 4px; padding-right: 0; padding-left: 0; min-width: auto; max-width: none; flex-shrink: 0; flex-basis: auto; -unity-font-style: normal; scale: 1 1; rotate: 0; border-left-width: 0; border-right-width: 0; margin-bottom: 2px; padding-top: 0; flex-wrap: nowrap; justify-content: flex-start; align-self: auto; overflow: hidden; visibility: visible; display: flex; position: relative; flex-grow: 0; border-top-width: 0;" />
            <ui:FloatField label="Distance" value="0" name="magnetic-toggle-distance" tooltip="How far away the magnet pulls" class="inputField" style="flex-direction: row; color: rgb(255, 0, 0); -unity-text-outline-color: rgb(0, 0, 0); background-color: rgb(0, 0, 0); opacity: 1; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); width: auto; height: 30px;" />
        </ui:VisualElement>
        <ui:VisualElement name="roll-into-settings" style="flex-grow: 1; flex-direction: row; height: 30px; border-top-width: 0; margin-bottom: 0; padding-bottom: 0; margin-top: 0; padding-top: 0; width: auto;">
            <ui:Toggle label="Roll&#10;" name="roll-toggle" toggle-on-label-click="true" value="false" tooltip="Tile collapses when player stands on it" class="toggleField" style="color: rgb(229, 229, 229); -unity-text-align: upper-left; width: auto; flex-direction: row-reverse; margin-right: 4px; flex-wrap: nowrap; height: 30px; margin-top: 2px;" />
            <ui:FloatField label="Speed Needed" value="0" name="roll-toggle-speed-needed" tooltip="How much speed is needed to break it" enabled="true" class="inputField" style="flex-direction: row; color: rgb(255, 0, 0); -unity-text-outline-color: rgb(0, 0, 0); background-color: rgb(0, 0, 0); opacity: 1; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); width: auto; height: 30px; font-size: 10px; align-items: stretch; align-content: auto; background-size: 100% 100%; transform-origin: center; text-overflow: clip; white-space: nowrap; -unity-text-align: upper-left; margin-left: 0; margin-right: 4px; padding-right: 0; padding-left: 0; min-width: auto; max-width: none; flex-shrink: 0; flex-basis: auto; -unity-font-style: normal; scale: 1 1; rotate: 0; border-left-width: 0; border-right-width: 0; margin-bottom: 2px; padding-top: 0; flex-wrap: nowrap; justify-content: flex-start; align-self: auto; overflow: hidden; visibility: visible; display: flex; position: relative; flex-grow: 0; border-top-width: 0;" />
            <ui:FloatField label="Time until Repair" value="-1" name="roll-toggle-time-until-repair" tooltip="How long after the tile breaks until it restores.  -1 for never." class="inputField" style="flex-direction: row; color: rgb(255, 0, 0); -unity-text-outline-color: rgb(0, 0, 0); background-color: rgb(0, 0, 0); opacity: 1; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); width: auto; height: 30px;" />
        </ui:VisualElement>
        <ui:VisualElement name="wood-settings" style="flex-grow: 1; flex-direction: row; height: 30px; border-top-width: 0; margin-bottom: 0; padding-bottom: 0; margin-top: 0; padding-top: 0; width: auto;">
            <ui:Toggle label="Wood" name="wood-toggle" toggle-on-label-click="true" value="false" tooltip="Tile can be cut into" class="toggleField" style="color: rgb(229, 229, 229); -unity-text-align: upper-left; width: auto; flex-direction: row-reverse; margin-right: 4px; flex-wrap: nowrap; height: 30px; margin-top: 2px;" />
            <ui:FloatField label="Time spent cutting" value="0" name="wood-toggle-cut-time" tooltip="How long a player has to cut it before its destroyed" enabled="true" class="inputField" style="flex-direction: row; color: rgb(255, 0, 0); -unity-text-outline-color: rgb(0, 0, 0); background-color: rgb(0, 0, 0); opacity: 1; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); width: auto; height: 30px; font-size: 10px; align-items: stretch; align-content: auto; background-size: 100% 100%; transform-origin: center; text-overflow: clip; white-space: nowrap; -unity-text-align: upper-left; margin-left: 0; margin-right: 4px; padding-right: 0; padding-left: 0; min-width: auto; max-width: none; flex-shrink: 0; flex-basis: auto; -unity-font-style: normal; scale: 1 1; rotate: 0; border-left-width: 0; border-right-width: 0; margin-bottom: 2px; padding-top: 0; flex-wrap: nowrap; justify-content: flex-start; align-self: auto; overflow: hidden; visibility: visible; display: flex; position: relative; flex-grow: 0; border-top-width: 0;" />
            <ui:FloatField label="Time until Repair" value="-1" name="wood-toggle-time-until-repair" tooltip="How long after the tile is cut until it restores.  -1 for never." class="inputField" style="flex-direction: row; color: rgb(255, 0, 0); -unity-text-outline-color: rgb(0, 0, 0); background-color: rgb(0, 0, 0); opacity: 1; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); width: auto; height: 30px;" />
        </ui:VisualElement>
        <ui:VisualElement name="diggable-settings" style="flex-grow: 1; flex-direction: row; height: 30px; border-top-width: 0; margin-bottom: 0; padding-bottom: 0; margin-top: 0; padding-top: 0; width: auto; margin-left: 0;">
            <ui:Toggle label="Diggable" name="diggable-toggle" toggle-on-label-click="true" value="false" tooltip="Tile can be dug into" class="toggleField" style="color: rgb(229, 229, 229); -unity-text-align: upper-left; width: auto; flex-direction: row-reverse; margin-right: 4px; flex-wrap: nowrap; height: 30px; margin-top: 2px;" />
            <ui:FloatField label="Hardness" value="0" name="diggable-toggle-dig-time" tooltip="How long a player has to cut it before its destroyed" enabled="true" class="inputField" style="flex-direction: row; color: rgb(255, 0, 0); -unity-text-outline-color: rgb(0, 0, 0); background-color: rgb(0, 0, 0); opacity: 1; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); width: auto; height: 30px; font-size: 10px; align-items: stretch; align-content: auto; background-size: 100% 100%; transform-origin: center; text-overflow: clip; white-space: nowrap; -unity-text-align: upper-left; margin-left: 0; margin-right: 4px; padding-right: 0; padding-left: 0; min-width: auto; max-width: none; flex-shrink: 0; flex-basis: auto; -unity-font-style: normal; scale: 1 1; rotate: 0; border-left-width: 0; border-right-width: 0; margin-bottom: 2px; padding-top: 0; flex-wrap: nowrap; justify-content: flex-start; align-self: auto; overflow: hidden; visibility: visible; display: flex; position: relative; flex-grow: 0; border-top-width: 0;" />
            <ui:FloatField label="Time until Repair" value="-1" name="diggable-toggle-time-until-repair" tooltip="How long after the tile is cut until it restores.  -1 for never." class="inputField" style="flex-direction: row; color: rgb(255, 0, 0); -unity-text-outline-color: rgb(0, 0, 0); background-color: rgb(0, 0, 0); opacity: 1; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); width: auto; height: 30px;" />
        </ui:VisualElement>
        <ui:Label text="Tile:" name="tile-text" double-click-selects-word="false" style="color: rgb(229, 229, 229); height: 30px;" />
        <ui:Label text="Scroll Speed: " name="scroll-speed-text" double-click-selects-word="false" style="color: rgb(229, 229, 229); height: 30px;" />
    </ui:VisualElement>
</ui:UXML>
